  "Email": "newuser@example.com",
  "Password": "NewUser@123",
  "FirstName": "New",
  "LastName": "User"
}

###
POST {{HotelManagement_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "Email": "newuser@example.com",
  "Password": "NewUser@123"
}

